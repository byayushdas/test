generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  password        String
  role            Role
  roleId          String?  @unique
  uniqueId        String?  @unique
  walletAddress   String?  @unique

  averageRating   Float    @default(0)
  reviewCount     Int      @default(0)
  profileImage    String?
  profilePhoto    String?

  regDate         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Profiles (One-to-One)
  farmerProfile       FarmerProfile?
  processorProfile    ProcessorProfile?
  distributorProfile  DistributorProfile?
  retailerProfile     RetailerProfile?

  // Details (One-to-One)
  kycDetails          UserKyc?
  bankDetails         UserBankDetails?

  // Reviews (One-to-Many)
  reviewsGiven        UserReview[] @relation("Reviewer")
  reviewsReceived     UserReview[] @relation("Reviewee")

  // Batches (One-to-Many)
  farmerBatches       FarmerBatch[]
  processorBatches    ProcessorBatch[]
  distributorBatches  DistributorBatch[]
  retailerBatches     RetailerBatch[]

  // Relations
  buyerOrders        PurchaseOrder[] @relation("BuyerOrders")
  sellerOrders       PurchaseOrder[] @relation("SellerOrders")
  transactions       Transaction[]
  notifications      Notification[]

  @@map("users")
}

enum Role {
  FARMER
  PROCESSOR
  DISTRIBUTOR
  RETAILER
  ADMIN
}

// -----------------------------------------
// PROFILES
// -----------------------------------------

model FarmerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  farmName            String?
  farmLocation        String?
  latitude            Float?
  longitude           Float?
  totalLandArea       String?
  mainCultivatedCrops String[]
  farmingPractice     String?

  @@map("farmer_profiles")
}

model ProcessorProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  facilityName          String?
  facilityLocation      String?
  processingCapacity    String?
  mainProcessedProducts String?
  complianceStandards   String?

  @@map("processor_profiles")
}

model DistributorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName         String?
  location            String?
  storageCapacity     String?
  operatingFacilities String?
  transportFleet      String?

  @@map("distributor_profiles")
}

model RetailerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storeName      String?
  storeLocation  String?
  shelfCapacity  String?
  storeTypeFocus String?
  employeeCount  String?

  @@map("retailer_profiles")
}

// -----------------------------------------
// USER DETAILS
// -----------------------------------------

model UserKyc {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  aadhaarNumber        String?
  aadhaarFront         String?
  aadhaarFrontPublicId String?
  aadhaarBack          String?
  aadhaarBackPublicId  String?
  submitKyc            Boolean  @default(false)
  kycStatus            String   @default("Pending Verification")
  rejectionReason      String?
  verificationDate     DateTime?

  @@map("user_kyc")
}

model UserBankDetails {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  branchLocation    String?

  @@map("user_bank_details")
}

model UserReview {
  id         String   @id @default(cuid())
  reviewerId String   
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  
  userId     String   
  user       User     @relation("Reviewee", fields: [userId], references: [id], onDelete: Cascade)
  
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())

  @@map("user_reviews")
}

// -----------------------------------------
// BATCHES
// -----------------------------------------

model FarmerBatch {
  id               String   @id // e.g. BATCH-2026-XXXX
  farmerId         String   
  farmer           User     @relation(fields: [farmerId], references: [id])
  roleId           String?
  
  cropName         String
  category         String
  quantity         Float    
  originalQuantity Float?
  pricePerKg       Float
  
  harvestDate      DateTime?
  cropImage        String?
  qrCode           String?
  traceUrl         String?
  
  status           FarmerStatus @default(Unlisted)
  soldTo           String?
  soldDate         DateTime?
  totalSaleValue   Float?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  processorConsumed ProcessorConsumedBatch[]

  @@map("farmer_batches")
}

enum FarmerStatus {
  Unlisted
  Listed
  Sold
}

model ProcessorBatch {
  id                 String   @id // e.g. PROC-2026-XXXX
  processorId        String   
  processor          User     @relation(fields: [processorId], references: [id])
  roleId             String?

  productName        String
  category           String
  itemType           ItemType @default(PROCESSED)

  quantity           Float
  originalQuantity   Float?
  pricePerUnit       Float
  remainingStock     Float?

  supplierFarmerId   String?  
  supplierFarmer     String?
  processingStatus   String?
  processingQuantity Float    @default(0)
  sentForProcessingDate DateTime?
  consumedQuantity   Float    @default(0)
  
  parentRawBatchId   String?
  parentRawBatchIds  Json?

  productImage       String?
  qrCodeUrl          String?
  traceUrl           String?

  status             ProcessorStatus @default(In_Stock)
  processingDate     DateTime?
  originDetails      Json?

  soldTo             String?
  soldDate           DateTime?
  totalSaleValue     Float?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  processingHistory  ProcessorProcessingHistory[]
  consumedBatches    ProcessorConsumedBatch[]

  @@map("processor_batches")
}

enum ItemType {
  RAW
  PROCESSED
  DISTRIBUTED
}

enum ProcessorStatus {
  In_Stock
  Listed
  Unlisted
  Dispatched
  Archived
}

model ProcessorProcessingHistory {
  id               String   @id @default(cuid())
  processorBatchId String
  processorBatch   ProcessorBatch @relation(fields: [processorBatchId], references: [id], onDelete: Cascade)
  
  processedBatchId String
  quantityUsed     Float
  date             DateTime @default(now())

  @@map("processor_processing_history")
}

model ProcessorConsumedBatch {
  id               String   @id @default(cuid())
  processorBatchId String
  processorBatch   ProcessorBatch @relation(fields: [processorBatchId], references: [id], onDelete: Cascade)
  
  rawBatchId       String
  rawBatch         FarmerBatch? @relation(fields: [rawBatchId], references: [id], onDelete: SetNull)
  quantityUsed     Float

  @@map("processor_consumed_batches")
}

model DistributorBatch {
  id                 String   @id // e.g. DIST-2026-XXXX
  distributorId      String   
  distributor        User     @relation(fields: [distributorId], references: [id])
  roleId             String?

  productName        String
  category           String
  quantity           Float
  originalQuantity   Float?
  pricePerUnit       Float

  itemType           ItemType @default(DISTRIBUTED)
  remainingStock     Float?

  supplierProcessorId String? 
  supplierProcessor   String?
  processingStatus    String? 
  processingQuantity  Float   @default(0)
  sentForProcessingDate DateTime?
  consumedQuantity    Float   @default(0)

  parentProcessedBatchId  String?
  parentProcessedBatchIds Json?

  productImage        String?
  qrCodeUrl           String?
  traceUrl            String?

  status              DistributorStatus @default(In_Stock)
  date                DateTime?
  originDetails       Json?

  soldTo              String?
  soldDate            DateTime?
  totalSaleValue      Float?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  processingHistory   DistributorProcessingHistory[]

  @@map("distributor_batches")
}

enum DistributorStatus {
  In_Stock
  Listed
  Unlisted
  Dispatched
  Archived
}

model DistributorProcessingHistory {
  id                 String   @id @default(cuid())
  distributorBatchId String
  distributorBatch   DistributorBatch @relation(fields: [distributorBatchId], references: [id], onDelete: Cascade)
  
  processedBatchId   String
  quantityUsed       Float
  date               DateTime @default(now())

  @@map("distributor_processing_history")
}

model RetailerBatch {
  id                 String   @id // e.g. RET-2026-XXXX
  retailerId         String   
  retailer           User     @relation(fields: [retailerId], references: [id])
  roleId             String?

  productName        String
  category           String
  quantity           Float
  originalQuantity   Float?
  pricePerUnit       Float

  parentDistBatchId  String?
  parentDistBatchIds Json?

  productImage       String?
  qrCodeUrl          String?
  traceUrl           String?

  status             RetailerStatus @default(In_Stock)
  date               DateTime?
  originDetails      Json?

  soldTo             String?
  soldDate           DateTime?
  totalSaleValue     Float?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("retailer_batches")
}

enum RetailerStatus {
  In_Stock
  Listed
  Unlisted
  Sold
  Archived
}

// -----------------------------------------
// ORDERS & TRANSACTIONS
// -----------------------------------------

model PurchaseOrder {
  orderNumber       String   @id
  
  buyerRole         String
  buyerId           String   
  buyer             User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerName         String?
  buyerRoleId       String?

  sellerRole        String
  sellerId          String   
  seller            User     @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerName        String?
  sellerRoleId      String?

  batchId           String
  cropName          String
  quantityKg        Float
  pricePerUnit      Float?
  totalAmount       Float?

  deliveryStatus    DeliveryStatus @default(PENDING_SELLER_ACCEPTANCE)

  razorpayPaymentId String?
  razorpayRefundId  String?
  
  escrowStatus      EscrowStatus @default(PENDING)

  rejectionReason   String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  transactions      Transaction[]

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerRoleId, createdAt(sort: Desc)])
  @@index([buyerRoleId, createdAt(sort: Desc)])
  @@index([sellerId, updatedAt(sort: Desc)])
  @@index([buyerId, updatedAt(sort: Desc)])
  @@index([sellerRoleId, updatedAt(sort: Desc)])
  @@index([buyerRoleId, updatedAt(sort: Desc)])

  @@map("purchase_orders")
}

enum DeliveryStatus {
  PENDING_SELLER_ACCEPTANCE
  ACCEPTED
  DISPATCHED
  DELIVERED
  REJECTED
}

enum EscrowStatus {
  PENDING
  LOCKED
  RELEASED
}

model Transaction {
  transactionId String   @id // pay_XXXX
  userId        String   
  user          User     @relation(fields: [userId], references: [id])
  
  orderId       String?
  order         PurchaseOrder? @relation(fields: [orderId], references: [orderNumber])
  
  amount        Float
  type          TransactionType
  status        TransactionStatus @default(COMPLETED)
  description   String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@map("transactions")
}

enum TransactionType {
  DEBIT
  CREDIT
  ESCROW_HOLD
  ESCROW_RELEASE
  DEBIT_HOLD
  FARMER_PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean  @default(false)
  link      String?
  
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  ORDER_REQUEST
  ORDER_UPDATE
  PAYMENT
  DELIVERY
  SYSTEM
}
