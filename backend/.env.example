# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres.xxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
# Must be a secure random string in production
JWT_SECRET=

# Razorpay Integration (Escrow/Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend Connection (CORS)
# Use https://your-production-url.vercel.app in production
FRONTEND_URL=http://localhost:3000
